# Application — URL publique utilisée pour les redirects Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (utiliser https:// pour les projets cloud *.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only
SUPABASE_SERVICE_ROLE_KEY=
# HMAC dédié aux tokens d'autorisation future (jamais NEXT_PUBLIC_,
# jamais recyclé depuis SUPABASE_SERVICE_ROLE_KEY). ≥ 32 caractères.
SIDIAN_PAYMENT_AUTHORIZATION_TOKEN_SECRET=
# Référence du projet (sous-domaine avant .supabase.co/.supabase.in).
# Obligatoire et vérifiée au build sur Vercel Preview et Production.
SIDIAN_SUPABASE_PROJECT_REF=
# JWT minimal signé par le projet ciblé, role=sidian_environment_attestor,
# claims sidian_environment + sidian_project_ref. Obligatoire sur Vercel.
SUPABASE_ENVIRONMENT_ATTESTATION_JWT=
# JWT pré-généré portant role=stripe_customer_binding_writer et
# sidian_environment=local|staging|production. Requis uniquement si Stripe=true.
SUPABASE_STRIPE_BINDING_WRITER_JWT=

# local | staging | production. Obligatoire sur Vercel, même si Stripe=false.
SIDIAN_ENVIRONMENT=local

# Stripe — readiness explicite. Un build sans paiements utilise false.
NEXT_PUBLIC_STRIPE_PAYMENTS_ENABLED=false
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# LLM runtime (P0) — conversation assistant / extraction brouillon / texte d’aide
# disabled | stub | live — stub UNIQUEMENT si SIDIAN_ENVIRONMENT=local
# Mode explicite obligatoire si PROVIDER_ENABLED=true (pas de défaut stub)
# Production : live obligatoire si activé (fail-closed)
# Live fail-closed sans clé du provider primaire. Aucun outil financier exposé au modèle.
SIDIAN_LLM_PROVIDER_ENABLED=false
SIDIAN_LLM_TRANSPORT_MODE=disabled

# Provider primaire : openai | anthropic (défaut openai).
# SIDIAN_LLM_FALLBACK_PROVIDER est optionnel et doit différer du primaire ;
# la bascule est unique et ne se déclenche que sur une panne de transport
# retryable (réseau, 5xx, 429) — jamais sur un refus du modèle, une erreur
# d'authentification ni une erreur de configuration.
SIDIAN_LLM_PROVIDER=openai
SIDIAN_LLM_FALLBACK_PROVIDER=

# Variables génériques historiques : elles n'alimentent QUE le provider
# primaire. Un déploiement mono-provider existant reste inchangé.
SIDIAN_LLM_API_KEY=
SIDIAN_LLM_BASE_URL=https://api.openai.com/v1
SIDIAN_LLM_MODEL=gpt-4o-mini

# Surcharges per-provider — requises dès qu'un secours est configuré.
SIDIAN_LLM_OPENAI_API_KEY=
SIDIAN_LLM_OPENAI_BASE_URL=
SIDIAN_LLM_OPENAI_MODEL=

# Anthropic Messages API (x-api-key + anthropic-version, prompt système en
# champ racine, max_tokens obligatoire). ANTHROPIC_API_KEY est accepté en
# repli, derrière SIDIAN_LLM_ANTHROPIC_API_KEY.
# Défaut claude-haiku-4-5 : le runtime appelle en temperature 0 avec un
# timeout de quelques secondes ; les modèles Claude 5 rejettent temperature
# et raisonnent par défaut (les configurer ici reste possible, temperature
# est alors omise).
SIDIAN_LLM_ANTHROPIC_API_KEY=
SIDIAN_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
SIDIAN_LLM_ANTHROPIC_MODEL=claude-haiku-4-5
SIDIAN_LLM_ANTHROPIC_VERSION=2023-06-01

# Consommation SSE du provider (le résultat rendu à l'appelant reste agrégé).
SIDIAN_LLM_STREAMING_ENABLED=false

SIDIAN_LLM_HTTP_TIMEOUT_MS=8000
SIDIAN_LLM_MAX_RETRIES=1
SIDIAN_LLM_MAX_OUTPUT_TOKENS=1024
SIDIAN_LLM_BUDGET_MAX_REQUESTS_PER_MINUTE=30
SIDIAN_LLM_BUDGET_MAX_TOKENS_PER_MINUTE=50000
SIDIAN_LLM_BUDGET_MAX_REQUESTS_PER_SCOPE_PER_HOUR=200

# Email transactionnel (P0) — secrets serveur uniquement
# disabled | stub | live — stub UNIQUEMENT si SIDIAN_ENVIRONMENT=local
# Mode explicite obligatoire si PROVIDER_ENABLED=true (pas de défaut stub)
# Production : live obligatoire si activé (fail-closed)
SIDIAN_EMAIL_PROVIDER_ENABLED=false
SIDIAN_EMAIL_TRANSPORT_MODE=disabled
# brevo | resend — vendor d'envoi en mode live. Défaut : brevo.
# Les deux contrats HTTP diffèrent (en-tête d'auth, forme du corps) : le choix
# est explicite, jamais déduit de la forme de la clé.
SIDIAN_EMAIL_PROVIDER=brevo
# Brevo : clé API v3 (préfixe xkeysib-), PAS la clé SMTP.
SIDIAN_EMAIL_API_KEY=
# Doit appartenir à un domaine vérifié chez le vendor.
SIDIAN_EMAIL_FROM_ADDRESS=
SIDIAN_EMAIL_FROM_NAME=
SIDIAN_EMAIL_REPLY_TO=
SIDIAN_EMAIL_HTTP_TIMEOUT_MS=8000

# Cron (Vercel Cron → /api/cron/scanners|drains) — serveur uniquement
# ≥ 16 caractères (recommandé ≥ 32). Jamais en query string.
# Vercel envoie Authorization: Bearer $CRON_SECRET automatiquement.
CRON_SECRET=

# WhatsApp Cloud (G1-P) — secrets serveur uniquement
# disabled | stub | live — stub UNIQUEMENT si SIDIAN_ENVIRONMENT=local
# Mode explicite obligatoire si PROVIDER_ENABLED=true (pas de défaut stub)
SIDIAN_WHATSAPP_PROVIDER_ENABLED=false
SIDIAN_WHATSAPP_TRANSPORT_MODE=disabled
SIDIAN_WHATSAPP_ACCESS_TOKEN=
SIDIAN_WHATSAPP_PHONE_NUMBER_ID=
SIDIAN_WHATSAPP_BUSINESS_ACCOUNT_ID=
SIDIAN_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
SIDIAN_WHATSAPP_APP_SECRET=
SIDIAN_WHATSAPP_GRAPH_API_VERSION=v21.0
# Métadonnée canal (pas clé Graph)
SIDIAN_WHATSAPP_SIDIAN_SENDER_E164=
# Destinataire technique Guide (hors API métier)
SIDIAN_WHATSAPP_GUIDE_RECIPIENT_TECHNICAL_ID=
SIDIAN_WHATSAPP_HTTP_TIMEOUT_MS=8000

# ─────────────────────────────────────────────────────────────────────────────
# DÉVELOPPEMENT ET TESTS — jamais renseignées en production
# ─────────────────────────────────────────────────────────────────────────────

# Ouvre les routes d'aperçu /dev/assistant et /dev/workspace dans un build de
# production. Hors production elles sont toujours accessibles.
# Ne JAMAIS positionner à 1 sur un déploiement public : ces routes affichent
# des états de démonstration.
SIDIAN_ALLOW_DEV_ASSISTANT_PREVIEW=

# Base Postgres locale utilisée par les suites SQL (scripts/test-*.mjs).
# Ces suites refusent de s'exécuter contre autre chose qu'une base locale.
SIDIAN_TEST_DATABASE_URL=
SIDIAN_TEST_SUPABASE_URL=

# Force les tests d'intégration G1-K / G1-L à exiger une authentification
# réelle au lieu de s'auto-ignorer. Recommandé en CI : sans cela, ces suites
# se sautent silencieusement.
SIDIAN_G1K_REQUIRE_AUTH=
SIDIAN_G1L_REQUIRE_AUTH=

# ─────────────────────────────────────────────────────────────────────────────
# ABONNEMENT SIDIAN (facturation du prestataire) — serveur uniquement
# ─────────────────────────────────────────────────────────────────────────────
#
# POURQUOI DES VARIABLES DISTINCTES DE CELLES DE CONNECT
#
# Ce bloc pilote un flux d'argent OPPOSÉ à celui de Connect :
#   - STRIPE_SECRET_KEY / STRIPE_CONNECT_WEBHOOK_SECRET  : le client final paie
#     le prestataire, sur son compte connecté.
#   - STRIPE_BILLING_*                                    : le prestataire paie
#     Sidian, sur le compte plateforme.
# Partager le secret de webhook reviendrait à laisser un événement de paiement
# client écrire l'état d'abonnement (et inversement). Créez donc DEUX endpoints
# webhook dans Stripe, chacun avec son propre secret ; l'application refuse de
# démarrer la facturation si les deux secrets sont identiques.
#
# Les deux modules s'activent indépendamment : la route /api/stripe/webhook
# fonctionne avec l'un, l'autre, ou les deux. Sans ces variables, l'application
# démarre normalement, l'interface indique honnêtement que la gestion de
# l'abonnement est indisponible, et aucun abonnement n'est jamais simulé.
#
# MISE EN SERVICE (côté propriétaire) :
#   1. Créer dans Stripe le produit + le prix récurrent de l'offre (02 §6 :
#      Sidian Early Access, 49 € HT/mois). Le montant vit dans Stripe, jamais
#      dans le code.
#   2. Créer un endpoint webhook abonné à : customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted,
#      invoice.payment_failed.
#   3. Activer le Portail client Stripe (sans quoi « Gérer mon abonnement »
#      remonte une erreur Stripe explicite, jamais un faux succès).
#   4. Coller les trois valeurs ci-dessous.
#
# sk_test_* hors production, sk_live_* en production — refus sinon.
STRIPE_BILLING_SECRET_KEY=
# Identifiant du prix récurrent (price_..., pas prod_...).
STRIPE_BILLING_PRICE_ID=
# Secret de signature de l'endpoint FACTURATION. Doit différer de
# STRIPE_CONNECT_WEBHOOK_SECRET.
STRIPE_BILLING_WEBHOOK_SECRET=
#
# [DÉCISION COMMERCIALE NON TRANCHÉE] Durée, en mois, du verrouillage du tarif
# Early Access écrit dans prestataire.early_access_price_locked_until à la
# première activation.
#   - docs/SIDIAN_02_PRD_V2.md §6      : « prix maintenu 12 mois », 20 premiers comptes.
#   - docs/SIDIAN_03_ARCHITECTURE_TECHNIQUE_V2.md §1 : « verrouillage à vie »,
#     30 premiers comptes, « pas une fenêtre de 12 mois ».
# Les deux documents se contredisent ; le mécanisme est implémenté mais aucune
# durée n'est choisie par défaut. Laissée vide, AUCUNE promesse tarifaire n'est
# enregistrée. Renseignez-la seulement après avoir tranché et aligné les docs
# (12 = fenêtre de 12 mois ; un verrouillage « à vie » demandera une décision
# distincte, pas un grand nombre arbitraire ici).
STRIPE_BILLING_EARLY_ACCESS_LOCK_MONTHS=

# ─────────────────────────────────────────────────────────────────────────────
# FOURNIES PAR LA PLATEFORME — ne pas définir à la main
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL
# Attention : toute la validation au build est ignorée si VERCEL_ENV est absent.
# ─────────────────────────────────────────────────────────────────────────────
