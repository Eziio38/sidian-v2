# Application — URL publique utilisée pour les redirects Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (utiliser https:// pour les projets cloud *.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only
SUPABASE_SERVICE_ROLE_KEY=
# HMAC dédié aux tokens d'autorisation future (jamais NEXT_PUBLIC_,
# jamais recyclé depuis SUPABASE_SERVICE_ROLE_KEY). ≥ 32 caractères.
SIDIAN_PAYMENT_AUTHORIZATION_TOKEN_SECRET=
# Référence du projet (sous-domaine avant .supabase.co/.supabase.in).
# Obligatoire et vérifiée au build sur Vercel Preview et Production.
SIDIAN_SUPABASE_PROJECT_REF=
# JWT minimal signé par le projet ciblé, role=sidian_environment_attestor,
# claims sidian_environment + sidian_project_ref. Obligatoire sur Vercel.
SUPABASE_ENVIRONMENT_ATTESTATION_JWT=
# JWT pré-généré portant role=stripe_customer_binding_writer et
# sidian_environment=local|staging|production. Requis uniquement si Stripe=true.
SUPABASE_STRIPE_BINDING_WRITER_JWT=

# local | staging | production. Obligatoire sur Vercel, même si Stripe=false.
SIDIAN_ENVIRONMENT=local

# Stripe — readiness explicite. Un build sans paiements utilise false.
NEXT_PUBLIC_STRIPE_PAYMENTS_ENABLED=false
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# LLM runtime (P0) — conversation assistant / extraction brouillon / texte d’aide
# disabled | stub | live — Mode explicite obligatoire si PROVIDER_ENABLED=true
# Live fail-closed sans SIDIAN_LLM_API_KEY. Aucun outil financier exposé au modèle.
SIDIAN_LLM_PROVIDER_ENABLED=false
SIDIAN_LLM_TRANSPORT_MODE=disabled
SIDIAN_LLM_API_KEY=
SIDIAN_LLM_BASE_URL=https://api.openai.com/v1
SIDIAN_LLM_MODEL=gpt-4o-mini
SIDIAN_LLM_HTTP_TIMEOUT_MS=8000
SIDIAN_LLM_MAX_RETRIES=1
SIDIAN_LLM_MAX_OUTPUT_TOKENS=1024
SIDIAN_LLM_BUDGET_MAX_REQUESTS_PER_MINUTE=30
SIDIAN_LLM_BUDGET_MAX_TOKENS_PER_MINUTE=50000
SIDIAN_LLM_BUDGET_MAX_REQUESTS_PER_SCOPE_PER_HOUR=200

# Legacy alias (non utilisé par le runtime typé SIDIAN_LLM_*)
OPENAI_API_KEY=

# Email transactionnel (P0) — secrets serveur uniquement
# disabled | stub | live — stub UNIQUEMENT si SIDIAN_ENVIRONMENT=local
# Mode explicite obligatoire si PROVIDER_ENABLED=true (pas de défaut stub)
# Production : live obligatoire si activé (fail-closed)
SIDIAN_EMAIL_PROVIDER_ENABLED=false
SIDIAN_EMAIL_TRANSPORT_MODE=disabled
SIDIAN_EMAIL_API_KEY=
SIDIAN_EMAIL_FROM_ADDRESS=
SIDIAN_EMAIL_FROM_NAME=
SIDIAN_EMAIL_REPLY_TO=
SIDIAN_EMAIL_HTTP_TIMEOUT_MS=8000

# Cron (Vercel Cron → /api/cron/scanners|drains) — serveur uniquement
# ≥ 16 caractères (recommandé ≥ 32). Jamais en query string.
# Vercel envoie Authorization: Bearer $CRON_SECRET automatiquement.
CRON_SECRET=

# WhatsApp Cloud (G1-P) — secrets serveur uniquement
# disabled | stub | live — stub UNIQUEMENT si SIDIAN_ENVIRONMENT=local
# Mode explicite obligatoire si PROVIDER_ENABLED=true (pas de défaut stub)
SIDIAN_WHATSAPP_PROVIDER_ENABLED=false
SIDIAN_WHATSAPP_TRANSPORT_MODE=disabled
SIDIAN_WHATSAPP_ACCESS_TOKEN=
SIDIAN_WHATSAPP_PHONE_NUMBER_ID=
SIDIAN_WHATSAPP_BUSINESS_ACCOUNT_ID=
SIDIAN_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
SIDIAN_WHATSAPP_APP_SECRET=
SIDIAN_WHATSAPP_GRAPH_API_VERSION=v21.0
# Métadonnée canal (pas clé Graph)
SIDIAN_WHATSAPP_SIDIAN_SENDER_E164=
# Destinataire technique Guide (hors API métier)
SIDIAN_WHATSAPP_GUIDE_RECIPIENT_TECHNICAL_ID=
SIDIAN_WHATSAPP_HTTP_TIMEOUT_MS=8000
