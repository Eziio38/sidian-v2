{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sidian-g1-catalog",
  "title": "Sidian G1 execution catalog (non-normative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "gate",
    "lot",
    "normative",
    "scope",
    "g1_pillars",
    "spec_documents",
    "strict_inventory",
    "entries"
  ],
  "properties": {
    "catalog_version": { "type": "string", "minLength": 1 },
    "gate": { "const": "G1" },
    "lot": { "type": "string", "minLength": 1 },
    "normative": { "const": false },
    "scope": { "type": "string", "minLength": 1 },
    "g1_pillars": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "unit",
          "schemas",
          "permissions",
          "rls",
          "transitions",
          "idempotence",
          "audit"
        ]
      }
    },
    "spec_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluations", "requirements_matrix"],
      "properties": {
        "evaluations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "requirements_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "strict_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_prefixes"],
      "properties": {
        "id_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluation_id",
          "g1_pillars",
          "requirements",
          "coverage",
          "bindings"
        ],
        "properties": {
          "evaluation_id": {
            "type": "string",
            "pattern": "^EVAL-[A-Z]+-[0-9]+$"
          },
          "g1_pillars": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "unit",
                "schemas",
                "permissions",
                "rls",
                "transitions",
                "idempotence",
                "audit"
              ]
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z]+-[0-9]+$"
            }
          },
          "source_decisions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "rationale"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["exact", "partial", "analog", "none", "not_applicable"]
              },
              "rationale": { "type": "string", "minLength": 1 },
              "na_justification": { "type": "string", "minLength": 1 }
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "asserts"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["pnpm_script", "vitest_file"]
                },
                "command": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "asserts": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "const": "exit_code_0" }
                }
              }
            }
          }
        }
      }
    }
  }
}
